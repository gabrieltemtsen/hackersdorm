# Deployment used by `npx convex dev`
NEXT_PUBLIC_CONVEX_URL=

# Resend API Key for sending transactional hackathon emails
# (Registration confirmation, Submission receipts, Judge invitations, Winner alerts)
RESEND_API_KEY=
RESEND_FROM_EMAIL=HackersDorm <notifications@hackersdorm.com>

# Platform settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
